name "sdl-d"
description "D Bindings to Simple DirectMedia Library"
authors "Inochi2D Project"
copyright "Copyright © 2025, Inochi2D Project"
license "Zlib"

targetPath "out/"
targetType "library"

buildRequirements "allowWarnings"

configuration "win32" {
    platforms "windows"

    // x86
    lflags "/LIBPATH:$PACKAGE_DIR/libs/x86" platform="x86"
    copyFiles "libs/x86/SDL3.dll" "libs/x86/SDL3.pdb" platform="x86"

    // x86_64
    lflags "/LIBPATH:$PACKAGE_DIR/libs/x64" platform="x86_64"
    copyFiles "libs/x64/SDL3.dll" "libs/x64/SDL3.pdb" platform="x86_64"

    // arm64
    lflags "/LIBPATH:$PACKAGE_DIR/libs/arm64" platform="arm64"
    copyFiles "libs/arm64/SDL3.dll" "libs/arm64/SDL3.pdb" platform="arm64"

    libs "SDL3"
}

configuration "apple" {
    platforms "osx" "ios" "tvos"

    // tvOS
    lflags \
        "-F$HOME/Library/Frameworks/SDL3.xcframework/tvos-arm64" \
        platform="tvos"
    
    preBuildCommands \
        "cp -r $HOME/Library/Frameworks/SDL3.xcframework/tvos-arm64/SDL3.framework libs/." \
        platform="tvos"
    
    // tvOS (Simulator)
    lflags \
        "-F$HOME/Library/Frameworks/SDL3.xcframework/tvos-arm64_x86_64-simulator" \
        platform="tvos-simulator"
    
    preBuildCommands \
        "cp -r $HOME/Library/Frameworks/SDL3.xcframework/tvos-arm64_x86_64-simulator/SDL3.framework libs/." \
        platform="tvos-simulator"

    // iOS
    lflags \
        "-F$HOME/Library/Frameworks/SDL3.xcframework/ios-arm64" \
        platform="ios"
    
    preBuildCommands \
        "cp -r $HOME/Library/Frameworks/SDL3.xcframework/ios-arm64/SDL3.framework libs/." \
        platform="ios"

    // iOS (Simulator)
    lflags \
        "-F$HOME/Library/Frameworks/SDL3.xcframework/ios-arm64_x86_64-simulator" \
        platform="ios-simulator"
    
    preBuildCommands \
        "cp -r $HOME/Library/Frameworks/SDL3.xcframework/ios-arm64_x86_64-simulator/SDL3.framework libs/." \
        platform="ios-simulator"

    // OSX
    lflags \
        "-F$HOME/Library/Frameworks/SDL3.xcframework/macos-arm64_x86_64" \
        platform="osx"
    
    preBuildCommands \
        "cp -r $HOME/Library/Frameworks/SDL3.xcframework/macos-arm64_x86_64/SDL3.framework libs/." \
        platform="osx"

    copyFiles "libs/SDL3.framework"
    lflags "-framework" "SDL3" "-rpath" "."
}

configuration "posix" {
    libs "SDL3"
}
